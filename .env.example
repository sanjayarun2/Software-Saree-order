NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Base URL for email verification links. Use your production domain in production (e.g. https://yourdomain.com).
# In Supabase Dashboard: Auth → URL Configuration → set Site URL and add Redirect URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Sign-In (native mobile + Supabase). Web OAuth client ID from Google Cloud Console.
NEXT_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# FCM push when app is closed (requires android/app/google-services.json in CI via GOOGLE_SERVICES_JSON_B64 secret)
NEXT_PUBLIC_ENABLE_FCM_PUSH=true

# Shared Chatwoot host (Messages inbox). Prefer a stable HTTPS domain, not a temporary tunnel.
NEXT_PUBLIC_CHATWOOT_BASE_URL=https://chat.yourdomain.com

# Meta WhatsApp Embedded Signup (Velo → Connect WhatsApp). App ID + Configuration ID are public.
# Create Configuration ID in Meta Developer → Facebook Login for Business → Configurations
# (variation: WhatsApp Embedded Signup). App secret stays in Supabase Edge Function secrets only.
NEXT_PUBLIC_META_APP_ID=
NEXT_PUBLIC_WA_ES_CONFIG_ID=

# To reduce emails landing in Spam: (1) Verify 'From' address in Supabase, (2) Add SPF/DKIM/DMARC DNS records for your domain, (3) In Supabase Dashboard → Auth → Email Templates, avoid spam-trigger words and broken HTML.

# --- Supabase Edge Function secrets (set via `supabase secrets set`, not in client) ---
# META_APP_ID / META_APP_SECRET — same Meta app as Embedded Signup (token exchange)
# CHATWOOT_BASE_URL — stable Chatwoot origin
# CHATWOOT_DEFAULT_ACCOUNT_ID / CHATWOOT_DEFAULT_ACCESS_TOKEN — soft-launch shared account
# CHATWOOT_PLATFORM_TOKEN — optional; Platform API token to auto-create one account per shop
